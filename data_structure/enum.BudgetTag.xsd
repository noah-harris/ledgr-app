<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="BudgetTag">
    <xs:annotation><xs:documentation>enum.BudgetTag. Primary key: idBudgetTag. Unique: TagDisplayName, (CategoryLevel1Name, CategoryLevel2Name, CategoryLevel3Name).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idBudgetTag" type="Guid">
        <xs:annotation><xs:documentation>Primary key.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="TagDisplayName" type="String100"/>
      <xs:element name="CategoryLevel1Name" type="String100"/>
      <xs:element name="CategoryLevel2Name" type="String100" minOccurs="0"/>
      <xs:element name="CategoryLevel3Name" type="String100" minOccurs="0"/>
      <xs:element name="Description" type="String200" minOccurs="0"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
