<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="Unit">
    <xs:annotation><xs:documentation>dim.Unit. Primary key: idUnit. Unique: Symbol, UnitName, (UnitType, isBaseUnit).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUnit" type="Guid">
        <xs:annotation><xs:documentation>Primary key.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="UnitType" type="String100">
        <xs:annotation><xs:documentation>References dim.UnitType.UnitType.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Symbol" type="String15"/>
      <xs:element name="UnitAbbreviation" type="String10"/>
      <xs:element name="UnitName" type="String50"/>
      <xs:element name="UnitNamePlural" type="String50"/>
      <xs:element name="ConversionFactor" type="xs:double"/>
      <xs:element name="isBaseUnit" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Computed in SQL: ConversionFactor = 1.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="isCurrency" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Computed in SQL: UnitType = 'CURRENCY'.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
