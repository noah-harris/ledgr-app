<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="TransactionItemTag">
    <xs:annotation><xs:documentation>usr.TransactionItemTag. Primary key: (idUsers, idAccount, idStatement, idTransaction, idTransactionItem, idTransactionItemTag).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idAccount" type="Guid"/>
      <xs:element name="idStatement" type="Guid"/>
      <xs:element name="idTransaction" type="Guid"/>
      <xs:element name="idTransactionItem" type="Guid">
        <xs:annotation><xs:documentation>References usr.TransactionItem (idUsers, idAccount, idStatement, idTransaction, idTransactionItem).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idTransactionItemTag" type="Guid">
        <xs:annotation><xs:documentation>Primary key (with the item's key).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Value" type="String200"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
