<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="Statement">
    <xs:annotation><xs:documentation>usr.Statement. Primary key: (idUsers, idAccount, idStatement).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idAccount" type="Guid">
        <xs:annotation><xs:documentation>References usr.Account (idUsers, idAccount).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idStatement" type="Guid">
        <xs:annotation><xs:documentation>Primary key (with idUsers, idAccount).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idImage" type="Guid" minOccurs="0">
        <xs:annotation><xs:documentation>References usr.FileListAccountImage (idUsers, idFile).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="StatementDate" type="xs:date"/>
      <xs:element name="StartDate" type="xs:dateTime"/>
      <xs:element name="EndDate" type="xs:dateTime"/>
      <xs:element name="StartBalance" type="Money"/>
      <xs:element name="EndBalance" type="Money"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
