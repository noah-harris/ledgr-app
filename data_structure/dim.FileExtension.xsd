<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="FileExtension">
    <xs:annotation><xs:documentation>dim.FileExtension. Primary key: FileExtension. Unique: (FileExtension, isSupportedImageExtension).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="FileExtension" type="String255">
        <xs:annotation><xs:documentation>Primary key. Lowercase, no leading dot.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="MimeType" type="String255"/>
      <xs:element name="isSupportedImageExtension" type="xs:boolean"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
