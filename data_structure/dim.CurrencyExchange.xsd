<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="CurrencyExchange">
    <xs:annotation><xs:documentation>dim.CurrencyExchange. Primary key: (idCurrencyFrom, idCurrencyTo, Date).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idCurrencyFrom" type="Guid">
        <xs:annotation><xs:documentation>References dim.Currency.idCurrency.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idCurrencyTo" type="Guid">
        <xs:annotation><xs:documentation>References dim.Currency.idCurrency.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Date" type="xs:date"/>
      <xs:element name="ExchangeRate" type="xs:double"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
