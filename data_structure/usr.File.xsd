<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="File">
    <xs:annotation><xs:documentation>usr.File. Primary key: (idUsers, idFile). Unique: (idUsers, idFile, isSupportedImageExtension).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idFile" type="Guid">
        <xs:annotation><xs:documentation>Primary key (with idUsers).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="FileName" type="String850"/>
      <xs:element name="FileExtension" type="String255">
        <xs:annotation><xs:documentation>References dim.FileExtension (FileExtension, isSupportedImageExtension).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="FullFileName" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>Computed in SQL: FileName + '.' + FileExtension.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="FileSizeBytes" type="xs:long" minOccurs="0"/>
      <xs:element name="isSupportedImageExtension" type="xs:boolean"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
