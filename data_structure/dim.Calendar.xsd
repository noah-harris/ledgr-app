<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="Calendar">
    <xs:annotation><xs:documentation>dim.Calendar. Primary key: Date.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="Date" type="xs:date">
        <xs:annotation><xs:documentation>Primary key.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="DayOfWeek" type="xs:unsignedByte"/>
      <xs:element name="DayOfMonth" type="xs:unsignedByte"/>
      <xs:element name="DayOfYear" type="xs:short"/>
      <xs:element name="WeekOfYear" type="xs:unsignedByte"/>
      <xs:element name="Month" type="xs:unsignedByte"/>
      <xs:element name="Quarter" type="xs:unsignedByte"/>
      <xs:element name="Year" type="xs:short"/>
      <xs:element name="DayName" type="String10"/>
      <xs:element name="DayNameShort" type="Char3"/>
      <xs:element name="MonthName" type="String10"/>
      <xs:element name="MonthNameShort" type="Char3"/>
      <xs:element name="MonthYear" type="Char7"/>
      <xs:element name="QuarterLabel" type="Char7"/>
      <xs:element name="MonthKey" type="xs:int"/>
      <xs:element name="QuarterKey" type="xs:int"/>
      <xs:element name="YearKey" type="xs:short"/>
      <xs:element name="FiscalMonth" type="xs:unsignedByte"/>
      <xs:element name="FiscalQuarter" type="xs:unsignedByte"/>
      <xs:element name="FiscalYear" type="xs:short"/>
      <xs:element name="FiscalYearLabel" type="Char6"/>
      <xs:element name="IsWeekend" type="xs:boolean"/>
      <xs:element name="IsWeekday" type="xs:boolean"/>
      <xs:element name="IsHoliday" type="xs:boolean"/>
      <xs:element name="HolidayName" type="String50" minOccurs="0"/>
      <xs:element name="IsBusinessDay" type="xs:boolean"/>
      <xs:element name="IsLeapYear" type="xs:boolean"/>
      <xs:element name="IsLastDayOfMonth" type="xs:boolean"/>
      <xs:element name="IsFirstDayOfMonth" type="xs:boolean"/>
      <xs:element name="FirstDayOfMonth" type="xs:date"/>
      <xs:element name="LastDayOfMonth" type="xs:date"/>
      <xs:element name="FirstDayOfQuarter" type="xs:date"/>
      <xs:element name="LastDayOfQuarter" type="xs:date"/>
      <xs:element name="FirstDayOfYear" type="xs:date"/>
      <xs:element name="LastDayOfYear" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
