<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="Account">
    <xs:annotation><xs:documentation>usr.Account. Primary key: (idUsers, idAccount). StartDate must be before EndDate.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idAccount" type="Guid">
        <xs:annotation><xs:documentation>Primary key (with idUsers).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idAccountType" type="Guid">
        <xs:annotation><xs:documentation>References enum.AccountType.idAccountType.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idOrganization" type="Guid">
        <xs:annotation><xs:documentation>References usr.Organization (idUsers, idOrganization).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idCurrency" type="Guid">
        <xs:annotation><xs:documentation>References dim.Unit.idUnit.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="AccountName" type="String200"/>
      <xs:element name="StartDate" type="xs:dateTime"/>
      <xs:element name="EndDate" type="xs:dateTime"/>
      <xs:element name="LoginPage" type="xs:string" minOccurs="0"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
