<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="DocumentTag">
    <xs:annotation><xs:documentation>usr.DocumentTag. Primary key: (idUsers, idDocument, idDocumentTagType).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idDocument" type="Guid">
        <xs:annotation><xs:documentation>References usr.Document (idUsers, idDocument).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idDocumentTagType" type="Guid">
        <xs:annotation><xs:documentation>References usr.DocumentTagType (idUsers, idDocumentTagType).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Value" type="String200" minOccurs="0"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
