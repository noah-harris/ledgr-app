<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="TransactionType">
    <xs:annotation><xs:documentation>enum.TransactionType. Primary key: idTransactionType.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idTransactionType" type="Guid">
        <xs:annotation><xs:documentation>Primary key.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="TransactionTypeName" type="String255"/>
      <xs:element name="Scope" type="String25"/>
      <xs:element name="Cashflow" type="String25"/>
      <xs:element name="isPositive" type="xs:boolean"/>
      <xs:element name="isItemEntryRequired" type="xs:boolean" minOccurs="0"/>
      <xs:element name="Description" type="String500"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
