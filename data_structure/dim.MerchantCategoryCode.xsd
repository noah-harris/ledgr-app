<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="MerchantCategoryCode">
    <xs:annotation><xs:documentation>dim.MerchantCategoryCode. Primary key: Mcc.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="Mcc" type="Char4">
        <xs:annotation><xs:documentation>Primary key.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="RangeStart" type="Char4"/>
      <xs:element name="RangeEnd" type="Char4"/>
      <xs:element name="RangeDescription" type="String200" minOccurs="0"/>
      <xs:element name="IsReserved" type="xs:boolean"/>
      <xs:element name="IsoDescription" type="String400" minOccurs="0"/>
      <xs:element name="UsdaDescription" type="String400" minOccurs="0"/>
      <xs:element name="StripeDescription" type="String400" minOccurs="0"/>
      <xs:element name="StripeCode" type="String100" minOccurs="0"/>
      <xs:element name="VisaDescription" type="String400" minOccurs="0"/>
      <xs:element name="VisaReqClearingName" type="String200" minOccurs="0"/>
      <xs:element name="AlipayDescription" type="String400" minOccurs="0"/>
      <xs:element name="MastercardDescription" type="String400" minOccurs="0"/>
      <xs:element name="MastercardAbbrAirlineName" type="String200" minOccurs="0"/>
      <xs:element name="AmexDescription" type="String400" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
