<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:ledgr"
           targetNamespace="urn:ledgr"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common.xsd"/>

  <xs:complexType name="Transaction">
    <xs:annotation><xs:documentation>usr.Transaction. Primary key: (idUsers, idAccount, idStatement, idTransaction). Checks: TransactionDate before the day after PostDate; InvoiceDate and DueDate both null or InvoiceDate &lt;= DueDate; StartDate and EndDate both null or StartDate &lt; EndDate; Amount &lt;&gt; 0; idTransactionParent &lt;&gt; idTransaction.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="idUsers" type="Guid">
        <xs:annotation><xs:documentation>References dbo.Users.idUsers.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idAccount" type="Guid">
        <xs:annotation><xs:documentation>References usr.Account (idUsers, idAccount).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idStatement" type="Guid">
        <xs:annotation><xs:documentation>References usr.Statement (idUsers, idAccount, idStatement).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idTransaction" type="Guid">
        <xs:annotation><xs:documentation>Primary key (with idUsers, idAccount, idStatement).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idTransactionGroup" type="Guid" minOccurs="0">
        <xs:annotation><xs:documentation>References usr.TransactionGroup (idUsers, idTransactionGroup).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idTransactionParent" type="Guid" minOccurs="0">
        <xs:annotation><xs:documentation>References usr.Transaction (idUsers, idAccount, idStatement, idTransaction).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idTransactionType" type="Guid">
        <xs:annotation><xs:documentation>References enum.TransactionType.idTransactionType.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idPayee" type="Guid">
        <xs:annotation><xs:documentation>References usr.Payee (idUsers, idPayee).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idImageInvoice" type="Guid" minOccurs="0">
        <xs:annotation><xs:documentation>References usr.FileListTransactionImage (idUsers, idFile).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="idImageReceipt" type="Guid" minOccurs="0">
        <xs:annotation><xs:documentation>References usr.FileListTransactionImage (idUsers, idFile).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="TransactionDate" type="xs:dateTime"/>
      <xs:element name="PostDate" type="xs:date"/>
      <xs:element name="InvoiceDate" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="DueDate" type="xs:date" minOccurs="0"/>
      <xs:element name="StartDate" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="EndDate" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="ReferenceNumber" type="String100" minOccurs="0"/>
      <xs:element name="Amount" type="Money">
        <xs:annotation><xs:documentation>Must not be 0.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="StatementText" type="String200" minOccurs="0"/>
      <xs:element name="isValidated" type="xs:boolean" minOccurs="0"/>
      <xs:element name="isTransactionSplitChild" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Computed in SQL: idTransactionParent IS NOT NULL.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE().</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Updated" type="xs:dateTime" minOccurs="0">
        <xs:annotation><xs:documentation>DATETIME2(0), defaults to GETDATE(); kept current by the trg_&lt;Table&gt;_SetUpdated trigger.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
